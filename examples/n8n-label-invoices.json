{
  "name": "Postlane · Label invoice conversations",
  "active": false,
  "nodes": [
    {
      "id": "schedule",
      "name": "Every five minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      }
    },
    {
      "id": "fetch",
      "name": "Find invoice mail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [230, 0],
      "parameters": {
        "url": "https://YOUR_POSTLANE_HOST/api/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "q", "value": "invoice" },
            { "name": "folder", "value": "inbox" },
            { "name": "limit", "value": "50" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "split",
      "name": "One message at a time",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [460, 0],
      "parameters": { "fieldToSplitOut": "items", "options": {} }
    },
    {
      "id": "filter",
      "name": "Needs Finance label",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [690, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "not-labeled",
              "leftValue": "={{ !$json.labels.includes('Finance') }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "label",
      "name": "Apply workspace label",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, -80],
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://YOUR_POSTLANE_HOST/api/messages/' + $json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { labels: [...new Set([...$json.labels, 'Finance'])] } }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every five minutes": {
      "main": [[{ "node": "Find invoice mail", "type": "main", "index": 0 }]]
    },
    "Find invoice mail": {
      "main": [
        [{ "node": "One message at a time", "type": "main", "index": 0 }]
      ]
    },
    "One message at a time": {
      "main": [[{ "node": "Needs Finance label", "type": "main", "index": 0 }]]
    },
    "Needs Finance label": {
      "main": [
        [{ "node": "Apply workspace label", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {},
  "tags": []
}

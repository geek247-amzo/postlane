# Generate .env with: python scripts/configure.py --host inbox.example.com --mail-host mail.example.com
COMPOSE_PROJECT_NAME=postlane
APP_ENV=production
APP_HOST=inbox.example.com
MAIL_HOST=mail.example.com
APP_URL=https://inbox.example.com
DEMO_MODE=false
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD
ENCRYPTION_KEY=GENERATE_ENCRYPTION_KEY
BOOTSTRAP_TOKEN=GENERATE_BOOTSTRAP_TOKEN

# Exact, operator-approved IMAP/SMTP hostnames. TLS validation is always enabled.
MAIL_ALLOWED_HOSTS=mail.example.com

# Webhook origins must be explicitly allowlisted (scheme + host + optional port).
WEBHOOK_ALLOWED_ORIGINS=
# Optional trusted private n8n origins. Do not use this for arbitrary customer URLs.
WEBHOOK_PRIVATE_ORIGINS=

# Register both providers with https://APP_HOST/api/oauth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# OpenAI-compatible chat-completions endpoint, opt-in per mailbox.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional Stalwart management API for aliases; restricted operator credential.
STALWART_API_URL=
STALWART_API_TOKEN=
